{
  "name": "ems-call-centre-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "EMS Call Centre System Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:agent": "tsx src/scripts/seedAgent.ts",
    "seed:state-language": "tsx src/scripts/seedStateLanguageMapping.ts",
    "apply:virtual-agent-passwords": "tsx src/scripts/applyVirtualAgentDefaultPasswords.ts",
    "create:test-task": "tsx src/scripts/createTestTask.ts",
    "create:test-data": "tsx src/scripts/createTestData.ts",
    "update:task-dates": "tsx src/scripts/updateTaskDates.ts",
    "test:admin": "tsx src/scripts/testAdminService.ts",
    "update:emails": "tsx src/scripts/updateUserEmails.ts",
    "migrate:status": "tsx src/scripts/migratePendingToSampledInQueue.ts",
    "migrate:farmer-language": "tsx src/scripts/migrateFarmerLanguagesFromState.ts",
    "cleanup:officer-number-activities": "tsx src/scripts/deleteActivitiesWithOfficerNumber.ts",
    "reset:dev-operational-data": "tsx src/scripts/resetDevOperationalData.ts",
    "drop:unused-databases": "tsx src/scripts/dropUnusedDatabases.ts",
    "audit:agent-screens": "tsx src/scripts/auditAgentScreens.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.12",
    "resend": "^6.7.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.27",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
